# ============================================================
# Cross-platform line ending strategy
# ============================================================
# All text files are normalized to LF in the repository.
# On checkout, Git converts to the platform's native line ending
# (CRLF on Windows, LF on macOS/Linux).

# Default: text files get LF in repo, native on checkout
* text=auto

# ============================================================
# Source code — force LF
# ============================================================
*.rs      text eol=lf
*.toml    text eol=lf
*.lock    text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.svg     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.gitignore   text eol=lf
*.gitattributes text eol=lf

# ============================================================
# Binary files
# ============================================================
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.bmp     binary
*.tif     binary
*.tiff    binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.eot     binary
*.ttf     binary
*.otf     binary
*.db      binary
*.bin     binary
*.blf     binary
*.mdf     binary
*.mf4     binary